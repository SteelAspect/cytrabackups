{
	"schemaVersion": 1,
	"id": "cytrabackups",
	"version": "${version}",
	"name": "Alloy Backups",
	"description": "Deduplicating world backups for technical servers: chunk-level dedup, zstd, scheduled backups with GFS pruning, safe full and partial (chunk) restores with recycle-bin rollback, off-site copies and Discord notifications. Server-side; the optional client GUI is in the same jar.",
	"authors": [
		"SteelAspect"
	],
	"contact": {
		"sources": "https://github.com/SteelAspect/cytrabackups"
	},
	"license": "MIT",
	"icon": "assets/cytrabackups/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.steelaspect.cytrabackups.CytraBackups"
		],
		"client": [
			"dev.steelaspect.cytrabackups.client.CytraBackupsClient"
		],
		"modmenu": [
			"dev.steelaspect.cytrabackups.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"cytrabackups.mixins.json"
	],
	"accessWidener": "cytrabackups.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"alloy-ui": ">=1.4.0 <2.0.0"
	}
}
